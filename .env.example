# .env.example
# AI Gateway 变量由 CLI 在部署时自动注入（本文件声明了它才会注入）
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# 三模型各司其职（可选覆盖；留空则用代码内置默认）
#   VLM_MODEL    = @makers/minimax-m3        影像理解（读 CT 图）
#   REPORT_MODEL = @makers/deepseek-v4-pro    报告生成（文本强模）
#   CHECK_MODEL  = @makers/deepseek-v4-flash  一致性自检（异族交叉验证）
VLM_MODEL=
REPORT_MODEL=
CHECK_MODEL=

# 第三方视觉 Provider（可选）。Makers 免费池 402 时启用：
# 同时设 BASE_URL + API_KEY 后，vision 节点改走第三方 OpenAI 兼容视觉模型；
# REPORT / CHECK 仍走 Makers 池。SILICONFLOW_VLM_MODEL 留空用默认 Qwen-VL。
SILICONFLOW_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_VLM_MODEL=
